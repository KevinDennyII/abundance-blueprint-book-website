# Contact form — get a free access key at https://web3forms.com
# Sign up with your email for now; change the recipient in the Web3Forms
# dashboard when the client's email address is ready.
VITE_WEB3FORMS_ACCESS_KEY=

# Work With Me / booking redirects (public URLs; VITE_ so Vite can bake them in).
# Defaults live in src/lib/social.ts — set these only to override or fill owed URLs.
VITE_DISCOVERY_CALL_URL=
# "Start Here" collection SCRIPT src (legacy Infisical name; value is the script URL).
VITE_COACH_ACCOUNTABLE_START_HERE_IFRAME_SRC=
VITE_GUIDE_WALKTHROUGH_URL=
VITE_LIBRARY_HOURS_URL=
VITE_CASH_FLOW_INTENSIVE_KICKOFF_URL=

# Kit email signup (server-side runtime secrets on the API Server artifact — do NOT prefix with VITE_)
