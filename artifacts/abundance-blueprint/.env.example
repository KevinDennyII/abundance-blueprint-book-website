# Contact form — get a free access key at https://web3forms.com
# Sign up with your email for now; change the recipient in the Web3Forms
# dashboard when the client's email address is ready.
VITE_WEB3FORMS_ACCESS_KEY=

# Kit email signup (server-side runtime secrets — do NOT prefix with VITE_)
# Create a V4 API key in Kit → Settings → Developer
# KIT_API_KEY=
#
# Numeric form IDs from the Kit dashboard (Grow → Landing Pages & Forms).
# These are NOT the embed UIDs — use the embed UID only as a reference:
#   Chapter 1 form embed UID: e30afd8248
#   Long Money Circle form embed UID: 87ce6821c1
# KIT_CHAPTER1_FORM_ID=
# KIT_CIRCLE_FORM_ID=
